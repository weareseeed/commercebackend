# CommerceBackend local sandbox environment
# Copy to .env for a deterministic Prisma + Stripe test-mode sandbox.

DATABASE_URL=postgresql://commercebackend:commercebackend@localhost:5432/commercebackend
STRIPE_SECRET_KEY=sk_test_your_test_key
STRIPE_WEBHOOK_SECRET=whsec_your_test_webhook_secret
API_BASE_URL=http://localhost:4000
PORT=4000
OPERATOR_API_KEY=replace_with_a_long_random_operator_key
SANDBOX_MODE=true

# Development-only convenience for local Stripe webhook testing.
# Never enable this in production.
# BYPASS_STRIPE_SIGNATURE=true

# Optional: only needed for an external Gemini/Google AI Studio client
# that talks to this sandbox API. CommerceBackend itself does not read this.
# GOOGLE_API_KEY=your_google_ai_studio_key
