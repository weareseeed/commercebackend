DATABASE_URL=postgresql://commercebackend:commercebackend@localhost:5432/commercebackend
STRIPE_SECRET_KEY=sk_tes..._key
STRIPE_WEBHOOK_SECRET=whsec_your_test_webhook_secret
API_BASE_URL=http://localhost:4000
PORT=4000
OPERATOR_API_KEY=replace_me_with_a_long_random_operator_key
SANDBOX_MODE=true
# CORS: '*' (default) for the public agent API, or a comma-separated allowlist
# of origins for browser callers, e.g. https://app.example.com,https://admin.example.com
# CORS_ORIGIN=*
# Per-IP rate limit applied globally outside tests (sensitive routes may be tighter;
# /health, /ready, and the Stripe webhook are exempt).
# RATE_LIMIT_MAX=300
# RATE_LIMIT_WINDOW=1 minute
# Development-only convenience. Never enable this in production.
# BYPASS_STRIPE_SIGNATURE=true
# Optional for external Gemini/Google AI Studio clients that call this API.
# CommerceBackend itself does not read GOOGLE_API_KEY.
# GOOGLE_API_KEY=your_google_ai_studio_key
