# CommerceBackend hosted sandbox environment (Cloud Run / Railway / Fly).
#
# Copy these into your host's secret manager / env config. Do NOT commit real
# values. A hosted PUBLIC sandbox runs in production mode with SANDBOX_MODE=true
# and real Stripe TEST keys (never live keys, never the keyless mock).

# --- Database (managed Postgres: Cloud SQL / Neon / Supabase / Railway) ------
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/commercebackend?sslmode=require

# --- Runtime mode ------------------------------------------------------------
NODE_ENV=production
# Keeps the public sandbox read/demo routes enabled while in production mode.
SANDBOX_MODE=true
PORT=4000
# Public base URL of this API (used in Stripe redirect URLs, discovery).
API_BASE_URL=https://api.demo.commercebackend.com

# --- Stripe (TEST MODE ONLY for the sandbox) ---------------------------------
# Real sk_test_... / whsec_... values. Production boot REJECTS placeholder or
# live (sk_live_) keys while SANDBOX_MODE=true.
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# --- Operator access ---------------------------------------------------------
# Long random secret. Gates /v1/sandbox/reset, checkout approve/reject, and
# simulate-complete. Generate: openssl rand -hex 32
OPERATOR_API_KEY=REPLACE_WITH_LONG_RANDOM_SECRET

# --- Startup behavior (container entrypoint) ---------------------------------
# Apply migrations on deploy. Seed only when (re)initializing demo fixtures.
RUN_MIGRATIONS=true
RUN_SEED=false

# NEVER set BYPASS_STRIPE_SIGNATURE=true in production — the app refuses to boot.
