{
  "name": "commercebackend-monorepo",
  "version": "0.1.0",
  "private": true,
  "author": "Seeed LLC",
  "license": "Apache-2.0",
  "homepage": "https://github.com/weareseeed/commercebackend",
  "keywords": [
    "commerce",
    "agentic-commerce",
    "ai-agents",
    "ai-commerce",
    "stripe",
    "typescript",
    "marketplace",
    "open-source",
    "api",
    "commercebackend"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/weareseeed/commercebackend.git"
  },
  "scripts": {
    "dev": "pnpm --filter @commercebackend/api dev",
    "build": "pnpm -r build",
    "lint": "eslint . --ext .ts",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "selftest": "pnpm --filter @commercebackend/api selftest",
    "selftest:mock": "pnpm --filter @commercebackend/api selftest:mock",
    "selftest:stripe": "pnpm --filter @commercebackend/api selftest:stripe",
    "db:migrate": "pnpm --filter @commercebackend/db migrate",
    "db:reset": "pnpm --filter @commercebackend/db reset",
    "db:seed": "pnpm --filter @commercebackend/db seed",
    "format": "prettier --write \"**/*.{ts,json,md,yml,yaml}\""
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.2.4",
    "typescript": "^5.3.3",
    "tsx": "^4.7.0",
    "vitest": "^1.2.1"
  }
}
